{
  "cleanUrls": true,
  "routes": [
    { "src": "^/auth$", "dest": "/pages/auth.html" },
    { "src": "^/auth.html$", "dest": "/pages/auth.html" },
    { "src": "^/login$", "dest": "/pages/auth.html" },
    { "src": "^/dashboard$", "dest": "/pages/dashboard.html" },
    { "src": "^/dashboard.html$", "dest": "/pages/dashboard.html" },
    { "src": "^/resume$", "dest": "/pages/resume-builder.html" },
    { "src": "^/resume-builder$", "dest": "/pages/resume-builder.html" },
    { "src": "^/resume-builder.html$", "dest": "/pages/resume-builder.html" },
    { "src": "^/resume-analyzer$", "dest": "/pages/resume-analyzer.html" },
    { "src": "^/resume-analyzer.html$", "dest": "/pages/resume-analyzer.html" },
    { "src": "^/portfolio$", "dest": "/pages/portfolio-builder.html" },
    { "src": "^/portfolio-builder$", "dest": "/pages/portfolio-builder.html" },
    { "src": "^/portfolio-builder.html$", "dest": "/pages/portfolio-builder.html" },
    { "src": "^/public-portfolio$", "dest": "/pages/public-portfolio.html" },
    { "src": "^/public-portfolio.html$", "dest": "/pages/public-portfolio.html" },
    { "src": "^/p/(.*)$", "dest": "/pages/public-portfolio.html" },
    { "src": "^/career-agent$", "dest": "/pages/career-agent.html" },
    { "src": "^/career-agent.html$", "dest": "/pages/career-agent.html" },
    { "src": "^/skill-gap$", "dest": "/pages/skill-gap.html" },
    { "src": "^/skill-gap.html$", "dest": "/pages/skill-gap.html" },
    { "src": "^/recommendations$", "dest": "/pages/recommendations.html" },
    { "src": "^/recommendations.html$", "dest": "/pages/recommendations.html" },
    { "src": "^/learning-roadmap$", "dest": "/pages/learning-roadmap.html" },
    { "src": "^/learning-roadmap.html$", "dest": "/pages/learning-roadmap.html" },
    { "src": "^/profile$", "dest": "/pages/profile.html" },
    { "src": "^/profile.html$", "dest": "/pages/profile.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html" }
  ]
}

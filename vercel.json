{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/auth", "destination": "/frontend/pages/auth.html" },
    { "source": "/auth.html", "destination": "/frontend/pages/auth.html" },
    { "source": "/login", "destination": "/frontend/pages/auth.html" },
    { "source": "/dashboard", "destination": "/frontend/pages/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/frontend/pages/dashboard.html" },
    { "source": "/resume", "destination": "/frontend/pages/resume-builder.html" },
    { "source": "/resume-builder", "destination": "/frontend/pages/resume-builder.html" },
    { "source": "/resume-builder.html", "destination": "/frontend/pages/resume-builder.html" },
    { "source": "/resume-analyzer", "destination": "/frontend/pages/resume-analyzer.html" },
    { "source": "/resume-analyzer.html", "destination": "/frontend/pages/resume-analyzer.html" },
    { "source": "/portfolio", "destination": "/frontend/pages/portfolio-builder.html" },
    { "source": "/portfolio-builder", "destination": "/frontend/pages/portfolio-builder.html" },
    { "source": "/portfolio-builder.html", "destination": "/frontend/pages/portfolio-builder.html" },
    { "source": "/public-portfolio", "destination": "/frontend/pages/public-portfolio.html" },
    { "source": "/public-portfolio.html", "destination": "/frontend/pages/public-portfolio.html" },
    { "source": "/p/:id*", "destination": "/frontend/pages/public-portfolio.html" },
    { "source": "/career-agent", "destination": "/frontend/pages/career-agent.html" },
    { "source": "/career-agent.html", "destination": "/frontend/pages/career-agent.html" },
    { "source": "/skill-gap", "destination": "/frontend/pages/skill-gap.html" },
    { "source": "/skill-gap.html", "destination": "/frontend/pages/skill-gap.html" },
    { "source": "/recommendations", "destination": "/frontend/pages/recommendations.html" },
    { "source": "/recommendations.html", "destination": "/frontend/pages/recommendations.html" },
    { "source": "/learning-roadmap", "destination": "/frontend/pages/learning-roadmap.html" },
    { "source": "/learning-roadmap.html", "destination": "/frontend/pages/learning-roadmap.html" },
    { "source": "/profile", "destination": "/frontend/pages/profile.html" },
    { "source": "/profile.html", "destination": "/frontend/pages/profile.html" },
    { "source": "/pages/:match*", "destination": "/frontend/pages/:match*" },
    { "source": "/css/:match*", "destination": "/frontend/css/:match*" },
    { "source": "/js/:match*", "destination": "/frontend/js/:match*" },
    { "source": "/frontend/(.*)", "destination": "/frontend/$1" }
  ]
}

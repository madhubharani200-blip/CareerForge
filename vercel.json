{
  "cleanUrls": true,
  "routes": [
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "src": "^/auth$", "dest": "/frontend/pages/auth.html" },
    { "src": "^/auth.html$", "dest": "/frontend/pages/auth.html" },
    { "src": "^/login$", "dest": "/frontend/pages/auth.html" },
    { "src": "^/dashboard$", "dest": "/frontend/pages/dashboard.html" },
    { "src": "^/dashboard.html$", "dest": "/frontend/pages/dashboard.html" },
    { "src": "^/resume$", "dest": "/frontend/pages/resume-builder.html" },
    { "src": "^/resume-builder$", "dest": "/frontend/pages/resume-builder.html" },
    { "src": "^/resume-builder.html$", "dest": "/frontend/pages/resume-builder.html" },
    { "src": "^/resume-analyzer$", "dest": "/frontend/pages/resume-analyzer.html" },
    { "src": "^/resume-analyzer.html$", "dest": "/frontend/pages/resume-analyzer.html" },
    { "src": "^/portfolio$", "dest": "/frontend/pages/portfolio-builder.html" },
    { "src": "^/portfolio-builder$", "dest": "/frontend/pages/portfolio-builder.html" },
    { "src": "^/portfolio-builder.html$", "dest": "/frontend/pages/portfolio-builder.html" },
    { "src": "^/public-portfolio$", "dest": "/frontend/pages/public-portfolio.html" },
    { "src": "^/public-portfolio.html$", "dest": "/frontend/pages/public-portfolio.html" },
    { "src": "^/p/(.*)$", "dest": "/frontend/pages/public-portfolio.html" },
    { "src": "^/career-agent$", "dest": "/frontend/pages/career-agent.html" },
    { "src": "^/career-agent.html$", "dest": "/frontend/pages/career-agent.html" },
    { "src": "^/skill-gap$", "dest": "/frontend/pages/skill-gap.html" },
    { "src": "^/skill-gap.html$", "dest": "/frontend/pages/skill-gap.html" },
    { "src": "^/recommendations$", "dest": "/frontend/pages/recommendations.html" },
    { "src": "^/recommendations.html$", "dest": "/frontend/pages/recommendations.html" },
    { "src": "^/learning-roadmap$", "dest": "/frontend/pages/learning-roadmap.html" },
    { "src": "^/learning-roadmap.html$", "dest": "/frontend/pages/learning-roadmap.html" },
    { "src": "^/profile$", "dest": "/frontend/pages/profile.html" },
    { "src": "^/profile.html$", "dest": "/frontend/pages/profile.html" },
    { "src": "^/css/(.*)$", "dest": "/frontend/css/$1" },
    { "src": "^/js/(.*)$", "dest": "/frontend/js/$1" },
    { "src": "^/pages/(.*)$", "dest": "/frontend/pages/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/404.html" }
  ]
}
